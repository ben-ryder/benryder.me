---
import {getEntry, render} from "astro:content";

import Background from "./Background.astro";
import Font from "astro/components/Font.astro";

import "../../styles/reset.css"
import "./Layout.css"

const headerConfig = await getEntry("config", "header");
if (!headerConfig) throw new Error('Header config missing, should be file /content/Config/Header.md');
if (!headerConfig.data.links) throw new Error('Header config missing links, required for navigation menu');
const { Content: HeaderContent } = await render(headerConfig);

const footerConfig = await getEntry("config", "footer");
if (!footerConfig) throw new Error('Footer config missing, should be file /content/Config/Footer.md');
if (!footerConfig.data.links) throw new Error('Footer config missing links, required for footer menu');
const { Content: FooterContent } = await render(footerConfig);

interface Props {
	title?: string
	description?: string | null
	image?: {
		src: string
		alt: string
	}
}
const { title: titleProp, description, image } = Astro.props
const title = titleProp ? `${titleProp} | Ben Ryder` : "Ben Ryder"
---

<!doctype html>
<html lang="en" class="noise-texture">
	<head>
		{/** Metadata **/}
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="generator" content={Astro.generator} />

		{/** Sitemap **/}
		<link rel="sitemap" href="/sitemap-index.xml" />

		{/** Icons & Theme **/}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable="--font-lora" preload />
		<link rel="stylesheet" href="/styles/prism.css" />
		{/** preload underline images to prevent flash/CLS when loading on hover **/}
		<link rel="preload" href="/ink/underline-1-interact.svg" />
		<link rel="preload" href="/ink/underline-2-interact.svg" />

		{/** Open Graph Tags **/}
		<meta property="og:title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:locale" content="en_GB" />
		{description && <meta property="og:description" content={description} />}
		{image && (
			<meta property="og:image" content={image.src} />
			<meta property="og:image:alt" content={image.alt} />
		)}
	</head>
	<body>
		<Background/>
		<header>
			<HeaderContent/>
			<nav>
				<ul>
					{headerConfig.data.links.map(link => (
						<li><a href={link.href}>{link.text}</a></li>
					))}
				</ul>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<FooterContent/>
			<nav>
				<ul>
					{footerConfig.data.links.map(link => (
						<li><a href={link.href}>{link.text}</a></li>
					))}
				</ul>
			</nav>
		</footer>
	</body>
</html>
