---
import "./Card.css"

export interface Props {
    title: string;
    href: string
    description?: string | null
    publishedAt?: Date
}
const { title, href, description, publishedAt } = Astro.props
---
<li class="card">
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    {description && (
        <p class="card__description">{description}</p>
    )}
    {publishedAt && (
        <p class="card__date">Published {publishedAt.toDateString()}</p>
    )}
</li>