---
import {getEntry, render} from "astro:content";
import Layout from "../components/Layout/Layout.astro";
import Prose from "../components/Prose/Prose.astro";

const contactConfig = await getEntry("config", "contact");
if (!contactConfig) throw new Error('Contact page config missing, should be file /content/Config/Contact.md');
const { Content } = await render(contactConfig);
---

<Layout title="Contact">
    <Prose>
        <Content/>
    </Prose>
</Layout>
