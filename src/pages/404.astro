---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<h1>404 - Page Not Found</h1>
	<p>The page you requested could not be found. It's possible you've typed an incorrect URL or followed a dead link.</p>
	<p>If you think the page you tried to visit should exist you're welcome to <a href="https://github.com/ben-ryder/benryder.me">raise an issue</a>.</p>
</Layout>
