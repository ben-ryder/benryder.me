---
import {getCollection, render} from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import {getReadingTime} from "../../utils/get-reading-time.ts";
import {getRelatedContent} from "../../utils/get-related-content.ts";
import {filterPublished} from "../../utils/filter-published.ts";
import { Calendar, Clock, CodeXml, Globe } from '@lucide/astro';
import Listing from "../../components/Listing/Listing.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects
        .filter(filterPublished)
        .map(project => ({
            params: { id: project.id },
            props: { project },
        }));
}
const { project } = Astro.props;

const { Content } = await render(project);
const readingTime = getReadingTime(project.body ?? "")

const { relatedProjects, relatedPosts } = await getRelatedContent(project)
---

<Layout>
    <a href="/projects" >All Projects</a>
    <h1>{project.data.name}</h1>
    <ul class="metadata">
        <li><Clock size="20" /> {readingTime}</li>
        <li><Calendar size="20" /> Published {project.data.publishedAt.toDateString()}</li>
        {project.data.productUrl && (
            <li><Globe size="20" /><a href={project.data.productUrl}>Live Project</a></li>
        )}
        {project.data.repositoryUrl && (
            <li><CodeXml size="20" /> <a href={project.data.repositoryUrl}>Source Code</a></li>
        )}
    </ul>
    <div class="prose">
        <Content />
    </div>
    {project.data.tags?.length && (
        <ul class="tags">
            {project.data.tags.map(tag => (
                <li><a href={`/tags/${tag}`}>#{tag}</a></li>
            ))}
        </ul>
    )}
    {relatedProjects.length > 0 && (
        <Listing
            title="Related Projects"
            items={relatedProjects.map(project => ({
                title: project.data.name,
                description: project.data.description,
                href: `/projects/${project.id}`
            }))}
        />
    )}
    {relatedPosts.length > 0 && (
        <Listing
            title="Related Posts"
            items={relatedPosts.map(post => ({
                title: post.data.name,
                description: post.data.description,
                href: `/posts/${post.id}`
            }))}
        />
    )}
</Layout>
