---
import {getEntry, render} from 'astro:content';
import Layout from '../../components/Layout/Layout.astro';
import {getAllProjectTags} from "../../utils/tags.ts";
import {getAllProjects} from "../../utils/projects.ts";
import Listing from "../../components/Listing/Listing.astro";
import Prose from "../../components/Prose/Prose.astro";
import BadgeList from "../../components/Badges/BadgeList.astro";
import Badge from "../../components/Badges/Badge.astro";

const projectsConfig = await getEntry("config", "projects");
if (!projectsConfig) throw new Error('Projects page config missing, should be file /content/Config/Projects.md');
const { Content } = await render(projectsConfig);

const projects = await getAllProjects()
const tags = await getAllProjectTags()
---

<Layout title="Projects">
	<Prose>
		<h1>Projects</h1>
		<Content/>
	</Prose>

	{tags.length && (
		<BadgeList>
			{tags.map((tag) => (
				<Badge text={`#${tag}`} href={`/tags/${tag}`} />
			))}
		</BadgeList>
	)}
	<Listing
		items={projects.map(project => ({
			title: project.data.name,
			href: `/projects/${project.id}`,
			description: project.data.description,
			publishedAt: project.data.publishedAt
		}))}
	/>
</Layout>
