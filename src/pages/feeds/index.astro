---
import {getEntry, render} from "astro:content";
import Layout from "../../components/Layout/Layout.astro";
import Prose from "../../components/Prose/Prose.astro";

const feedsConfig = await getEntry("config", "feeds");
if (!feedsConfig) throw new Error('Feeds page config missing, should be file /content/Config/Feeds.md');
const { Content } = await render(feedsConfig);
---

<Layout title="RSS Feeds">
    <Prose>
        <Content/>
    </Prose>
</Layout>
