---
import { getCollection, render } from 'astro:content';
import Layout from "../../components/Layout/Layout.astro";
import {getAllTags} from "../../utils/tags.ts";
import Listing from "../../components/Listing/Listing.astro";
import Prose from "../../components/Prose/Prose.astro";
import PageHeader from "../../components/PageHeader/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs/Breadcrumbs.astro";

export async function getStaticPaths() {
    const tags = await getAllTags()
    return tags
        .map(tag => ({
            params: { id: tag },
            props: { tag },
        }));
}
const { tag } = Astro.props;

const allProjects = await getCollection("projects");
const projects = allProjects
    .filter((project) => {
        return project.data.status === 'published' && project.data.tags?.includes(tag)
    })
    .sort((a, b) => a.data.publishedAt > b.data.publishedAt ? 1 : -1)

const allPosts = await getCollection("posts");
const posts = allPosts
    .filter((post) => {
        return post.data.status === 'published' && post.data.tags?.includes(tag)
    })
    .sort((a, b) => a.data.publishedAt > b.data.publishedAt ? 1 : -1)
---

<Layout>
    <PageHeader>
        <Breadcrumbs
            slot="navigation"
            crumbs={[{text: "Tags", href: "/tags"}]}
            current={{text: tag, href: `/tags/${tag}`}}
        />
        <Prose slot="prose">
            <h1>Tags - {tag}</h1>
            <p>This page contains my projects and posts with the tag <b>{tag}</b>.</p>
        </Prose>
    </PageHeader>
    {projects.length > 0 && (
        <Listing
            title="Projects"
            items={projects.map(project => ({
                title: project.data.name,
                description: project.data.description,
                href: `/projects/${project.id}`
            }))}
        />
    )}
    {posts.length > 0 && (
        <Listing
            title="Posts"
            items={posts.map(post => ({
                title: post.data.name,
                description: post.data.description,
                href: `/posts/${post.id}`
            }))}
        />
    )}
</Layout>
