---
import {getCollection, getEntry, render} from 'astro:content';
import {getAllTags} from "../../utils/tags.ts";

import Layout from '../../components/Layout/Layout.astro';
import Prose from "../../components/Prose/Prose.astro";
import BadgeList from "../../components/Badges/BadgeList.astro";
import Badge from "../../components/Badges/Badge.astro";

const tags = await getAllTags()
---

<Layout>
    <Prose>
        <h1>All Tags</h1>
        <p>This page contains all tags used by my projects and tags.</p>
    </Prose>
    <BadgeList>
        {tags.map((tag) => (
            <Badge text={`#${tag}`} href={`/tags/${tag}`} />
        ))}
    </BadgeList>
</Layout>
