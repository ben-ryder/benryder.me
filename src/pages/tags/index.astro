---
import {getCollection, getEntry, render} from 'astro:content';
import {getAllTags} from "../../utils/tags.ts";

import Layout from '../../components/Layout/Layout.astro';
import Prose from "../../components/Prose/Prose.astro";
import BadgeList from "../../components/Badges/BadgeList.astro";
import Badge from "../../components/Badges/Badge.astro";
import PageHeader from "../../components/PageHeader/PageHeader.astro";
import PageContent from "../../components/PageContent/PageContent.astro";
import Breadcrumbs from "../../components/Breadcrumbs/Breadcrumbs.astro";

const tags = await getAllTags()
---

<Layout>
    <PageHeader>
        <Breadcrumbs
            slot="navigation"
            crumbs={[]}
            current={{text: "Tags", href: "/tags"}}
        />
        <Prose slot="prose">
            <h1>Tags</h1>
            <p>This page contains all tags used by my projects and tags.</p>
        </Prose>
    </PageHeader>
    <PageContent>
        <BadgeList>
            {tags.map((tag) => (
                    <Badge text={`#${tag}`} href={`/tags/${tag}`} />
            ))}
        </BadgeList>
    </PageContent>
</Layout>
