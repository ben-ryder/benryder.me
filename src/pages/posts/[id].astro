---
import {getCollection, render} from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import {getReadingTime} from "../../utils/get-reading-time.ts";
import {getRelatedContent} from "../../utils/get-related-content.ts";
import {filterPublished} from "../../utils/filter-published.ts";
import {Calendar, Clock} from "@lucide/astro";
import Listing from "../../components/Listing/Listing.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    return posts
        .filter(filterPublished)
        .map(post => ({
            params: { id: post.id },
            props: { post },
        }));
}
const { post } = Astro.props;

const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? "");
const { relatedProjects, relatedPosts } = await getRelatedContent(post)
---

<Layout>
    <a href="/posts">All Posts</a>
    <h1>{post.data.name}</h1>
    <ul class="metadata">
        <li><Clock size="20" /> {readingTime}</li>
        <li><Calendar size="20" /> Published {post.data.publishedAt.toDateString()}</li>
    </ul>
    <div class="prose">
        <Content />
    </div>
    {post.data.tags?.length && (
        <ul class="tags">
            {post.data.tags.map(tag => (
                <li><a href={`/tags/${tag}`}>#{tag}</a></li>
            ))}
        </ul>
    )}
    {relatedProjects.length > 0 && (
        <Listing
            title="Related Projects"
            items={relatedProjects.map(project => ({
                title: project.data.name,
                description: project.data.description,
                href: `/projects/${project.id}`
            }))}
        />
    )}
    {relatedPosts.length > 0 && (
        <Listing
            title="Related Posts"
            items={relatedPosts.map(post => ({
                title: post.data.name,
                description: post.data.description,
                href: `/posts/${post.id}`
            }))}
        />
    )}
</Layout>
