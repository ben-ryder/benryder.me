---
import {getEntry, render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {getAllPostTags} from "../../utils/tags.ts";
import {getAllPosts} from "../../utils/posts.ts";

const postsConfig = await getEntry("config", "posts");
if (!postsConfig) throw new Error('Posts page config missing, should be file /content/Config/Posts.md');
const { Content } = await render(postsConfig);

const posts = await getAllPosts()
const tags = await getAllPostTags()
---

<Layout>
	<h1>Posts</h1>
	<Content/>
	<p><a href="/feeds/posts.xml">RSS feed</a></p>
	{tags.length && (
		<ul>
			{tags.map(tag => (
				<li><a href={`/tags/${tag}`}>#{tag}</a></li>
			))}
		</ul>
	)}
	<ul>
		{posts.map((post) => (
			<li>
				<h3><a href={`/posts/${post.id}`}>{post.data.name}</a></h3>
				<p>{post.data.description}</p>
			</li>
		))}
	</ul>
</Layout>
