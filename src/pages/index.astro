---
import {getEntry, render} from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {getFeaturedProjects} from "../utils/projects.ts";
import {getFeaturedPosts} from "../utils/posts";
import Listing from "../components/Listing/Listing.astro";
import GithubLogo from "../assets/github-logo.svg"
import LinkedInLogo from "../assets/linkedin-logo.png"
import BlueskyLogo from "../assets/bluesky-logo.svg"

const homeConfig = await getEntry("config", "home");
if (!homeConfig) throw new Error('Home page config missing, should be file /content/Config/Home.md');
const { Content } = await render(homeConfig);

const featuredProjects = await getFeaturedProjects()
const featuredPosts = await getFeaturedPosts()
---

<Layout title="Home">
	<div class="prose">
		<Content/>
	</div>

	{/** todo: set profile URLs via env var? **/}
	<ul class="tags">
		<li>
			<GithubLogo/>
			<a href="https://github.com/ben-ryder">GitHub</a>
		</li>
		<li>
			<img src={LinkedInLogo.src} alt="" />
			<a href="https://www.linkedin.com/in/benryderdev">LinkedIn</a>
		</li>
		<li>
			<BlueskyLogo />
			<a href="https://bsky.app/profile/benryder.me">Bluesky</a>
		</li>
	</ul>

	<Listing
		title="Projects"
		items={featuredProjects.map(project => ({
			title: project.data.name,
			description: project.data.description,
			href: `/projects/${project.id}`
		}))}
	/>
	<a href="/projects">all projects</a>

	<Listing
		title="Posts"
		items={featuredPosts.map(post => ({
			title: post.data.name,
			description: post.data.description,
			href: `/posts/${post.id}`
		}))}
	/>
	<a href="/posts">all posts</a>
</Layout>
