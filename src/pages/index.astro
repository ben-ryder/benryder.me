---
import {getEntry, render} from 'astro:content';

import {getFeaturedProjects} from "../utils/projects.ts";
import {getFeaturedPosts} from "../utils/posts";

import Layout from '../components/Layout/Layout.astro';
import Listing from "../components/Listing/Listing.astro";
import Prose from "../components/Prose/Prose.astro";
import PageHeader from "../components/PageHeader/PageHeader.astro";
import BadgeList from "../components/Badges/BadgeList.astro";
import Badge from "../components/Badges/Badge.astro";

import GithubLogo from "../assets/social/github-logo.svg"
import LinkedInLogo from "../assets/social/linkedin-logo.png"
import BlueskyLogo from "../assets/social/bluesky-logo.svg"


const homeConfig = await getEntry("config", "home");
if (!homeConfig) throw new Error('Home page config missing, should be file /content/Config/Home.md');
const { Content } = await render(homeConfig);

const featuredProjects = await getFeaturedProjects()
const featuredPosts = await getFeaturedPosts()
---

<Layout title="Home">
	<PageHeader>
		<Prose slot="prose">
			<Content/>
		</Prose>

		{/** todo: set profile URLs via env var/config? **/}
		<BadgeList slot="meta">
			<Badge text="GitHub" href="https://github.com/ben-ryder">
				<GithubLogo />
			</Badge>
			<Badge text="LinkedIn" href="https://www.linkedin.com/in/benryderdev">
				<img src={LinkedInLogo.src} alt="" />
			</Badge>
			<Badge text="Bluesky" href="https://bsky.app/profile/benryder.me">
				<BlueskyLogo />
			</Badge>
		</BadgeList>
	</PageHeader>

	<Listing
		title="Projects"
		items={featuredProjects.map(project => ({
			title: project.data.name,
			href: `/projects/${project.id}`,
			description: project.data.description,
			publishedAt: project.data.publishedAt
		}))}
	/>
	<a href="/projects">all projects</a>

	<Listing
		title="Posts"
		items={featuredPosts.map(post => ({
			title: post.data.name,
			href: `/posts/${post.id}`,
			description: post.data.description,
			publishedAt: post.data.publishedAt
		}))}
	/>
	<a href="/posts">all posts</a>
</Layout>
