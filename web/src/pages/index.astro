---
import {getCollection} from "astro:content";

import GlobalLayout from '../patterns/layouts/GlobalLayout/GlobalLayout.astro';
import Greeter from "../patterns/components/Greeter/Greeter.astro";
import CardSimpleListing from "../patterns/components/CardSimpleListing/CardSimpleListing.astro";

import * as homeContent from "../../../cms/content/Home.md";

const contentHtml = await homeContent.compiledContent()
const socialLinks = [
    {
        text: "GitHub",
        url: "https://github.com/ben-ryder",
        iconCode: "github"
    },
    {
        text: "LinkedIn",
        url: "https://www.linkedin.com/in/benryderdev",
        iconCode: "linkedin"
    }
]

const featuredProjects = await getCollection('projects', ({data}) => {
	return data.status === 'published' && data.featured
})
const featuredGuides = await getCollection('guides', ({data}) => {
    return data.status === 'published' && data.featured
})
const featuredBlogPosts = await getCollection('blog-posts', ({data}) => {
	return data.status === 'published' && data.featured
})

---

<GlobalLayout title="Home">
	<Greeter
		contentHtml={contentHtml}
		socialLinks={socialLinks}
	/>

	<CardSimpleListing
		title="👨‍💻 Projects"
		viewAllText="All Projects"
		viewAllLink="/projects"
		cards={featuredProjects.map(project => {
			return {
				title: project.data.name,
				description: project.data.description,
				link: `/projects/${project.id}`
			}
		})}
	/>

	<CardSimpleListing
		title="📝 Guides"
		viewAllText="All Guides"
		viewAllLink="/guides"
		cards={featuredGuides.map(guide => {
			return {
				title: guide.data.name,
				description: guide.data.description,
				link: `/blog/${guide.id}`
			}
		})}
	/>

	<CardSimpleListing
		title="🤔 Blog Posts"
		viewAllText="All Blog Posts"
		viewAllLink="/blog"
		cards={featuredBlogPosts.map(post => {
			return {
				title: post.data.name,
				description: post.data.description,
				link: `/blog/${post.id}`
			}
		})}
	/>
</GlobalLayout>
