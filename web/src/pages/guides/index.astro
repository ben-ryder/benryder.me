---
import {getCollection, type CollectionEntry} from "astro:content";

import GlobalLayout from "../../patterns/layouts/GlobalLayout/GlobalLayout.astro";
import CardComplexListing from "src/patterns/components/CardComplexListing/CardComplexListing.astro";
import {orderByTimestamps} from "../../utils/order-by-timestamps";

const unorderedGuides = await getCollection('guides', ({ data }) => {
	return data.status === 'published'
})
const guides = orderByTimestamps<CollectionEntry<'guides'>>(unorderedGuides)
---

<GlobalLayout title="Guides">
	<CardComplexListing
		title="📝 Guides"
		description="<p>Technical guides, references, quick-tips and other hopefully helpful information.<br/>If you're interested in thought pieces and opinion based writing, see my <a href='/blog'>blog posts</a> instead.</p>"
		notFoundText="No Guides Found"
		tags={[]}
		cards={guides.map(guide => {
			return {
				title: guide.data.name,
				description: guide.data.description,
				link: `/guides/${guide.id}`,
				tags: [],
				createdAt: guide.data.createdAt,
				updatedAt: guide.data.updatedAt,
			}
		})}
	/>
</GlobalLayout>
