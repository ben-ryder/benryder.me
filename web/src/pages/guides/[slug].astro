---
import {getCollection, getEntries, render} from 'astro:content';

import GlobalLayout from "../../patterns/layouts/GlobalLayout/GlobalLayout.astro";
import ContentHero from "../../patterns/components/ContentHero/ContentHero.astro";
import {JArrowLink} from "@ben-ryder/jigsaw-react";
import CardSimpleListing from "../../patterns/components/CardSimpleListing/CardSimpleListing.astro";
import {formatTimestamp} from "../../utils/format-timestamp";
import {getReadingTime} from "../../utils/get-reading-time";

export async function getStaticPaths() {
	const guides = await getCollection('guides', ({ data }) => {
		return data.status === 'published' || data.status === "hidden"
	});
	return guides.map(guide => ({
		params: { slug: guide.id }, props: { guide },
	}));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const relatedProjects = guide.data.relatedProjects? await getEntries(guide.data.relatedProjects) : [];
const relatedGuides = guide.data.relatedGuides? await getEntries(guide.data.relatedGuides) : [];
const relatedBlogPosts = guide.data.relatedBlogPosts? await getEntries(guide.data.relatedBlogPosts) : [];

const metadata = [
	[
		{
			icon: "clock",
			text: getReadingTime(guide.body ?? "")
		},
	],
	[
		{
			icon: "calendar",
			text: `Published ${formatTimestamp(guide.data.createdAt)}`,
		}
	]
]
if (guide.data.updatedAt) {
	metadata[1].push({
		icon: "pencil",
		text: `Updated ${formatTimestamp(guide.data.updatedAt)}`,
	})
}
---

<GlobalLayout title={guide.data.name}>
	<ContentHero
		title={guide.data.name}
		metadata={metadata}
		tags={[]}
		tagsBaseUrl="/guides/tags/"
	/>

	<div class="max-width-container container-spacing">
		<JArrowLink href="/guides" direction="left">All Guides</JArrowLink>
	</div>

	<div class="max-width-container">
		<div class="j-prose">
			<Content />
		</div>
	</div>


	{(relatedProjects.length > 0 || relatedGuides.length > 0 || relatedBlogPosts.length > 0) &&
		<div class="max-width-container j-prose">
			<hr />
		</div>
	}

	{relatedProjects?.length > 0 &&
		<CardSimpleListing
			title="👨‍💻 Related Projects"
			cards={relatedProjects.map(project => {
				return {
					title: project.data.name,
					description: project.data.description,
					link: `/projects/${project.data.slug}`
				}
			})}
		/>
	}

	{relatedGuides.length > 0 &&
		<CardSimpleListing
			title="📝 Related Guides"
			cards={relatedGuides.map(guide => {
				return {
					title: guide.data.name,
					description: guide.data.description,
					link: `/guides/${guide.data.slug}`
				}
			})}
		/>
	}

	{relatedBlogPosts?.length > 0 &&
		<CardSimpleListing
			title="🤔 Related Blog Posts"
			cards={relatedBlogPosts.map(post => {
				return {
					title:guide.data.name,
					description:guide.data.description,
					link: `/blog/${post.data.slug}`
				}
			})}
		/>
	}
</GlobalLayout>
